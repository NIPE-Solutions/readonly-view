{
    "name": "@nipe-solutions/readonly-view",
    "version": "2.0.0",
    "packageManager": "npm@11.19.0",
    "description": "A deeply readonly, lazy, live view over mutable JavaScript data.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=22 <25"
    },
    "scripts": {
        "build": "npm run build:dist",
        "build:dist": "npm run clean && vite build && npm run build:types",
        "build:website": "npm run build:dist && vite build --config vite.website.config.ts",
        "build:types": "tsc --project tsconfig.build.json && rollup --config rollup.dts.config.mjs && node scripts/clean-types.mjs",
        "benchmark": "npm run build:dist && node benchmarks/benchmark.mjs",
        "benchmark:smoke": "npm run build:dist && node benchmarks/benchmark.mjs --smoke",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:types && npm run test:size && npm run test:package && npm run test:website && npm run benchmark:smoke",
        "clean": "node scripts/clean.mjs",
        "dev:website": "vite --config vite.website.config.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "package:artifact": "npm run build:dist && node scripts/pack-artifact.mjs",
        "prepublishOnly": "npm run release:check",
        "release:check": "npm run check && node scripts/verify-release.mjs && npm run package:artifact",
        "test": "npm run test:unit",
        "test:unit": "vitest run --project unit --passWithNoTests",
        "test:types": "tsc --project test/types/tsconfig.json --noEmit",
        "test:package": "npm run build:dist && node --test test/package/verify-package.test.mjs test/package/verify-registry.test.mjs",
        "test:size": "npm run build:dist && node scripts/check-bundle-size.mjs",
        "test:website": "npm run build:website && node scripts/verify-website.mjs",
        "test:browser": "playwright test",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --project unit --coverage"
    },
    "keywords": [
        "readonly",
        "proxy",
        "membrane",
        "typescript",
        "immutable-view"
    ],
    "author": "Nicholas Petrasek",
    "license": "MIT",
    "homepage": "https://readonly-view.nipesolutions.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NIPE-Solutions/readonly-view.git"
    },
    "bugs": {
        "url": "https://github.com/NIPE-Solutions/readonly-view/issues"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.4.1",
        "@vitest/coverage-v8": "^4.1.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "fast-check": "^4.9.0",
        "globals": "^17.3.0",
        "prettier": "^3.9.6",
        "rollup-plugin-dts": "^6.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    }
}
