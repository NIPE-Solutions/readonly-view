{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "labels": ["dependencies"],
    "rangeStrategy": "replace",
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "groupName": "lint and formatting",
            "matchPackageNames": [
                "eslint",
                "prettier",
                "typescript-eslint",
                "@eslint/js"
            ]
        },
        {
            "groupName": "vitest",
            "matchPackageNames": ["vitest", "@vitest/coverage-v8"]
        }
    ]
}
